#!/usr/bin/env bash
#
# fiddy: put your own keys in, privately.
#
# Generated by the setup-wizard-generator skill (library below the header is the
# template's, untouched), authored for the Fiddy client in
# /Users/lc/Projects/fiddy. Run it, then run scripts/fiddy-setup-verify.sh any
# time after that to re-check the same keys without re-reading this one.
#
# What it asks for, and why each one:
#
#   1. Neynar API key      a hosted index Fiddy can fall back to when your node
#                          is down. Probed with a deliberately wrong key FIRST,
#                          so a wiring mistake cannot be mistaken for a key
#                          problem.
#   2. Pinata JWT          optional, skipped unless you say yes. Fiddy does not
#                          use it yet; pinning is the usual reason to have one.
#   3. Reown project id    public, not a secret. The file currently holds the
#                          placeholder your_reown_project_id, which is why the
#                          wallet sheet does not connect.
#   4. Your node address   optional. Must answer /v1/info to be saved.
#
#
# It writes to apps/farcaster-web/.env.local only, atomically, mode 600,
# preserving every value already there. No value is ever printed back, and no
# value is ever passed in a command line.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────
# The safe writer and the read-only probes. Authored BELOW the STAGES marker, as
# the library above may not be edited — this only replaces the library's plain
# `write_env` with one that treats a file full of credentials like one.
#
# Three things the plain version does not do, and this does:
#
#   - it never follows a symlink and never overwrites a file that is not a
#     regular file belonging to this user, so a stray link cannot make this
#     rewrite something else entirely;
#   - it writes through a fresh mode-0600 file in the same directory and renames
#     it over the target, so the credentials are never briefly world-readable,
#     never half-written, and every unrelated line in the file is preserved;
#   - it puts a secret in a header through curl's `--config -` (stdin), never in
#     argv, because anything in argv is visible to every process on the machine.

if ! command -v curl >/dev/null 2>&1; then
  warn "curl is not installed, and every check in this wizard needs it."
  warn "Install curl (macOS ships it) and run this again."
  exit 1
fi

# Where the app's local env file lives. Resolved from this script's own location
# so the wizard works no matter which directory it is started from.
_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${FIDDY_ENV_FILE:-$_REPO_ROOT/apps/farcaster-web/.env.local}"

NEYNAR_LAST_STATUS="000"
PINATA_LAST_STATUS="000"
NODE_LAST_STATUS="000"
NODE_LAST_SUMMARY=""

write_env() {
  local key="$1" value="$2" dir tmp owner
  case "$value" in
    *$'\n'*|*$'\r'*)
      warn "refusing to write $key: the value has a line break in it"
      return 1
      ;;
  esac

  dir="$(dirname "$ENV_FILE")"
  mkdir -p "$dir"

  if [[ -L "$ENV_FILE" ]]; then
    warn "refusing to write $ENV_FILE: it is a symbolic link"
    return 1
  fi
  if [[ -e "$ENV_FILE" && ! -f "$ENV_FILE" ]]; then
    warn "refusing to write $ENV_FILE: it is not a regular file"
    return 1
  fi
  if [[ -e "$ENV_FILE" ]]; then
    owner="$(stat -f '%u' "$ENV_FILE" 2>/dev/null || stat -c '%u' "$ENV_FILE" 2>/dev/null)"
    if [[ -n "$owner" && "$owner" != "$(id -u)" ]]; then
      warn "refusing to write $ENV_FILE: it belongs to another user"
      return 1
    fi
    if [[ -s "$ENV_FILE" && ! -r "$ENV_FILE" ]]; then
      warn "refusing to write $ENV_FILE: it cannot be read, so its other values could not be kept"
      return 1
    fi
    case "$(stat -f '%Sp' "$ENV_FILE" 2>/dev/null || stat -c '%A' "$ENV_FILE" 2>/dev/null)" in
      *w) warn "$ENV_FILE is writable by people other than you; it will be tightened to mode 600" ;;
    esac
  fi

  tmp="$( (umask 077 && mktemp "$dir/.fiddy-env.XXXXXX") )" || {
    warn "could not create a temporary file in $dir"
    return 1
  }

  if [[ -f "$ENV_FILE" ]]; then
    # Everything except this key: the file may hold values this wizard knows
    # nothing about, and losing one of those would be a silent breakage.
    grep -vE "^[[:space:]]*${key}=" "$ENV_FILE" >"$tmp" || true
  fi
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  chmod 600 "$tmp"

  if ! mv "$tmp" "$ENV_FILE"; then
    rm -f "$tmp"
    warn "could not replace $ENV_FILE"
    return 1
  fi
  chmod 600 "$ENV_FILE"

  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s (mode 600)\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# One read-only request. Body goes to a file; the HTTP status is the output.
# A secret, when there is one, travels through curl's config on stdin.
_probe_request() {
  local url="$1" name="$2" secret="$3" out="$4"
  if [[ -n "$name" ]]; then
    case "$secret" in
      *'"'*|*$'\n'*|*$'\r'*)
        printf '000'
        return 2
        ;;
    esac
    printf 'header = "%s: %s"\n' "$name" "$secret" |
      curl --silent --show-error --max-time 12 --output "$out" --write-out '%{http_code}' --config - "$url"
  else
    curl --silent --show-error --max-time 12 --output "$out" --write-out '%{http_code}' "$url"
  fi
}

# Does Neynar accept this key? Read-only: one user lookup by fid.
neynar_probe() {
  local key="$1" out status
  out="$(mktemp)"
  # `|| status="000"` rather than `|| printf '000'`: curl prints its own 000 when
  # it cannot connect, so the old form could report "000000" — a status no server
  # ever sent, in a sentence a human has to read.
  status="$(_probe_request \
    'https://api.neynar.com/v2/farcaster/user/bulk?fids=3' 'x-api-key' "$key" "$out" 2>/dev/null)" || status="000"
  rm -f "$out"
  NEYNAR_LAST_STATUS="$status"
  [[ "$status" == "200" ]]
}

# Does Pinata accept this JWT? Pinata's own read-only test endpoint.
pinata_probe() {
  local jwt="$1" out status
  out="$(mktemp)"
  status="$(_probe_request \
    'https://api.pinata.cloud/data/testAuthentication' 'Authorization' "Bearer $jwt" "$out" 2>/dev/null)" || status="000"
  rm -f "$out"
  PINATA_LAST_STATUS="$status"
  [[ "$status" == "200" ]]
}

# Does this address answer like a Snapchain node? `/v1/info` and a chain height.
node_probe() {
  local url="$1" out status version
  url="${url%/}"
  out="$(mktemp)"
  status="$(_probe_request "$url/v1/info?dbstats=0" '' '' "$out" 2>/dev/null)" || status="000"
  NODE_LAST_STATUS="$status"
  if [[ "$status" == "200" ]] && grep -q 'maxHeight' "$out" 2>/dev/null; then
    version="$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$out" 2>/dev/null | head -n1 | sed -E 's/.*"([^"]*)"$/\1/')"
    if [[ -n "$version" ]]; then
      NODE_LAST_SUMMARY="it says it is version $version, and reports a chain height"
    else
      NODE_LAST_SUMMARY="it reports a chain height"
    fi
    rm -f "$out"
    return 0
  fi
  rm -f "$out"
  NODE_LAST_SUMMARY=""
  return 1
}

# A Reown project id is a public 32-character hexadecimal string. This is a
# format check and nothing more: the relay only validates over a websocket, so
# the real proof is the wallet sheet connecting in the browser.
reown_id_looks_right() {
  [[ "$1" =~ ^[0-9a-fA-F]{32}$ ]]
}
TOTAL_STAGES=4

banner "fiddy: the keys only you should have"

# ── 0 · what this does, before anything is asked ───────────────────────────
stage "Before we start"
say "This wizard collects three keys Fiddy can use, and the address of a node"
say "if you run one. You type each one here, in this window: nothing is pasted"
say "into a chat, and nothing is printed back."
say ""
say "It writes them to apps/farcaster-web/.env.local — a file that stays on this"
say "machine and is never committed (it is in .gitignore). Everything already in"
say "that file is kept; only the keys below are replaced."
note "Press Ctrl-C any time. Re-run it later and it offers what you already saved."
pause "Ready?"

# ── 1 · Neynar API key ─────────────────────────────────────────────────────
stage "Neynar — your own API key"
say "Neynar is a hosted index of Farcaster. With a key, Fiddy can read profiles,"
say "one account's casts, threads and verified addresses through it — which makes"
say "it a useful backup when your own node is down."
say ""
step "On the Neynar site, sign in and open your apps."
step "Create an app (the owner called theirs \"fiddy\"), then copy its API key."
note "The free plan is rate-limited: it is fine as a backup, not as your main read."
open_url "https://dev.neynar.com"

# Prove the wiring before a real key exists: a deliberately wrong key must come
# back as a clean refusal. If it does not, the request or the header is wrong and
# the real key would fail for a reason that has nothing to do with the key.
say ""
note "First, a wiring check with a key that is deliberately wrong:"
if neynar_probe "fiddy-wizard-deliberately-wrong-key"; then
  warn "a wrong key was ACCEPTED — do not trust this endpoint; stopping"
  exit 1
else
  note "  it refused the wrong key ($NEYNAR_LAST_STATUS) — the endpoint and header are right"
fi

say ""
ask_secret NEYNAR_API_KEY "Paste your Neynar API key (input hidden):"
if [[ -z "${NEYNAR_API_KEY:-}" ]]; then
  warn "no key entered — skipping Neynar (Fiddy works without it)"
  SKIPPED+=("Neynar key (Fiddy will not use Neynar as a backup)")
else
  say ""
  note "Checking the key you just typed, with one read-only request:"
  if neynar_probe "$NEYNAR_API_KEY"; then
    note "  accepted ($NEYNAR_LAST_STATUS) — Neynar is ready to be a backup"
    write_env VITE_NEYNAR_API_KEY "$NEYNAR_API_KEY"
  else
    warn "Neynar refused it ($NEYNAR_LAST_STATUS) — not saved; check the key and re-run"
    SKIPPED+=("Neynar key (it was refused, so nothing was saved)")
  fi
fi

# ── 2 · Pinata JWT (optional) ──────────────────────────────────────────────
stage "Pinata — optional, only if you pin images"
say "Pinata stores files for you and hands back a link. Fiddy does not need it"
say "today: photos you attach go to Fiddy's own media endpoint. It is here because"
say "pinning is the usual reason to have a key, and having it stored now saves a"
say "trip later."
note "It is written as PINATA_JWT, without the VITE_ prefix on purpose: a VITE_"
note "name is compiled into the browser bundle, and a storage key must not be."
open_url "https://app.pinata.cloud/developers/api-keys"
if confirm "Add a Pinata key now?"; then
  step "Create an API key, give it the 'pinFileToIPFS' scope, and copy the JWT."
  ask_secret PINATA_JWT "Paste the Pinata JWT (input hidden):"
  if [[ -z "${PINATA_JWT:-}" ]]; then
    warn "nothing entered — skipping"
    SKIPPED+=("Pinata JWT (nothing entered)")
  else
    note "Checking it with Pinata's own read-only test endpoint:"
    if pinata_probe "$PINATA_JWT"; then
      note "  accepted ($PINATA_LAST_STATUS)"
      write_env PINATA_JWT "$PINATA_JWT"
    else
      warn "Pinata refused it ($PINATA_LAST_STATUS) — not saved"
      SKIPPED+=("Pinata JWT (refused)")
    fi
  fi
else
  note "skipped"
  SKIPPED+=("Pinata JWT (skipped by choice)")
fi

# ── 3 · Reown (WalletConnect) project id ───────────────────────────────────
stage "Wallets — the Reown project id"
say "This one is NOT a secret: it is a public identifier that lets Fiddy's wallet"
say "sheet talk to Reown's relay. Right now the file still holds the placeholder"
say "your_reown_project_id, which is why the wallet side does not connect."
open_url "https://cloud.reown.com"
step "Sign in, create a project, and copy its Project ID (32 letters and numbers)."
say ""
ask VITE_WALLETCONNECT_PROJECT_ID "Paste the Reown project id:"
if [[ -z "${VITE_WALLETCONNECT_PROJECT_ID:-}" ]]; then
  warn "nothing entered — the placeholder stays, and wallets will not connect"
  SKIPPED+=("Reown project id (wallets stay disconnected)")
else
  if reown_id_looks_right "$VITE_WALLETCONNECT_PROJECT_ID"; then
    note "  format matches a Reown project id"
  else
    warn "that does not look like a Reown project id (32 letters and numbers)"
    warn "saving it anyway — the only real test is the wallet sheet connecting"
    SKIPPED+=("Reown project id (format not verified — check it in the wallet sheet)")
  fi
  write_env VITE_WALLETCONNECT_PROJECT_ID "$VITE_WALLETCONNECT_PROJECT_ID"
fi

# ── 4 · Your own node (optional) ───────────────────────────────────────────
stage "Your own node — optional"
say "If you run a Snapchain node, Fiddy reads and writes through it instead of"
say "anybody else's server. It needs a machine with about 2 TB of disk and an"
say "https address; the walkthrough is at https://fiddy.fun/client."
say ""
note "Leave this empty if you do not run one — Fiddy then reads from a public node,"
note "and you can still point it at one later from the in-app picker."
open_url "https://fiddy.fun/client"
ask VITE_SNAPCHAIN_HTTP_URL "Paste your node's address (https://...), or leave empty:"
if [[ -z "${VITE_SNAPCHAIN_HTTP_URL:-}" ]]; then
  note "skipped — the public node stays in use"
  SKIPPED+=("Your own node (not configured)")
else
  note "Asking that address for its own status (/v1/info):"
  if node_probe "$VITE_SNAPCHAIN_HTTP_URL"; then
    note "  it answered — $NODE_LAST_SUMMARY"
    write_env VITE_SNAPCHAIN_HTTP_URL "$VITE_SNAPCHAIN_HTTP_URL"
  else
    warn "it did not answer like a node ($NODE_LAST_STATUS) — not saved"
    SKIPPED+=("Your own node (it did not answer /v1/info)")
  fi
fi

# ── What changed on disk ───────────────────────────────────────────────────
stage "Where these went"
say "Only these names were written to:"
note "  $ENV_FILE"
for key in "${WRITTEN_ENV[@]:-}"; do
  [[ -n "$key" ]] && note "  · $key"
done
note "The file is readable by you alone (mode 600). Re-check any time with:"
note "  scripts/fiddy-setup-verify.sh"
pause "Press Enter to finish."

finish
