{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "strict": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.js"]
}