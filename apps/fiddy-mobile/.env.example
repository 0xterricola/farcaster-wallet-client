# Fiddy iOS — build-time configuration.
#
# Copy to `.env` (or export these before `pnpm ios`) to override what the app
# reads. Nothing here is a secret: a node URL is a hostname, and v1 ships no
# keys of any kind — no seed phrase, no custody key, no app key, no API key.

# The node the app reads through. Defaults to the Fiddy node baked into
# src/node/nodeConfig.ts (DEFAULT_NODE_URL).
EXPO_PUBLIC_FIDDY_NODE_URL=http://34.101.47.167:3381

# The FID whose follow graph the Feed tab reads. 0 = ask the user in the app.
EXPO_PUBLIC_FIDDY_FID=0