# `.node-version` is the runtime this project is built and verified against, and
# the one CI installs through `actions/setup-node`. Pin pnpm to it as well, so a
# shell that has a newer Node on PATH cannot silently run the gates on a
# different runtime. MEASURED 2026-10-21: on Node 25+ the jsdom wallet test files
# lose `localStorage` and `pnpm --filter farcaster-web test` reports failures CI
# never sees (104 of them on v26.10.0). See "Node version for local runs" in
# README.md.
use-node-version=20.19.5